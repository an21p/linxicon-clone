{
  "name": "linxicon-scaffold",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "serve": "vite build && NODE_ENV=production tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "build:vectors:minilm": "node scripts/build-minilm.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.12.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@huggingface/transformers": "^4.2.0",
    "d3-force": "^3.0.0",
    "fastify": "^5.8.5",
    "idb-keyval": "^6.2.5"
  }
}
