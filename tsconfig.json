{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vscode"],
    "paths": { "vscode-languageserver": ["./node_modules/vscode-languageserver-types"] }
  },
  "include": ["src", "vendor"]
}
